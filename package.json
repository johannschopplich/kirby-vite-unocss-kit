{
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "rm -rf public/dist && mprocs",
    "dev:unocss": "unocss --watch",
    "dev:vite": "vite",
    "build": "unocss && vite build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test:types": "tsc --noEmit",
    "format": "prettier \"**/*.{css,html,json,md,ts,yml}\" --write",
    "format:check": "prettier \"**/*.{css,html,json,md,ts,yml}\" --check"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^8.2.0",
    "@iconify-json/carbon": "^1.2.20",
    "@types/node": "^24.12.2",
    "@unocss/cli": "^66.6.8",
    "@unocss/eslint-plugin": "^66.6.8",
    "@unocss/preset-mini": "^66.6.8",
    "@unocss/preset-wind4": "^66.6.8",
    "@unocss/reset": "^66.6.8",
    "eslint": "^10.2.1",
    "mprocs": "^0.9.2",
    "postcss": "^8.5.10",
    "postcss-nesting": "^14.0.0",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3",
    "unocss": "^66.6.8",
    "vite": "^8.0.9",
    "vite-plugin-full-reload": "^1.2.0"
  }
}

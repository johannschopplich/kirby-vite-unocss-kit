{
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "rm -rf public/dist && dekit up && dekit attach",
    "dev:unocss": "unocss --watch",
    "dev:vite": "vite",
    "build": "unocss && vite build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test:types": "tsc --noEmit",
    "format": "prettier \"**/*.{css,html,json,md,ts,yml}\" --write",
    "format:check": "prettier \"**/*.{css,html,json,md,ts,yml}\" --check"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^10.0.0",
    "@iconify-json/carbon": "^1.2.30",
    "@types/node": "^26.6.11",
    "@unocss/cli": "^66.13.0",
    "@unocss/eslint-plugin": "^66.13.0",
    "@unocss/preset-mini": "^66.13.0",
    "@unocss/preset-wind4": "^66.13.0",
    "@unocss/reset": "^66.13.0",
    "eslint": "^10.15.0",
    "@dekit/cli": "^0.10.3",
    "postcss": "^8.5.33",
    "postcss-nesting": "^14.0.3",
    "prettier": "^3.10.1",
    "typescript": "^7.0.2",
    "unocss": "^66.13.0",
    "vite": "^8.4.0",
    "vite-plugin-full-reload": "^1.2.0"
  }
}
